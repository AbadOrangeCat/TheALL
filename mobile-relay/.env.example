# A DNS A/AAAA record must point this domain to your own server.
# Domain only: no scheme, slash or path.
PUBLIC_DOMAIN=theall.example.com

# Copy "Mac public key" from TheAll's mobile relay settings.
# This is the public half of an Ed25519 key, NOT an API key or private key.
THEALL_MAC_PUBLIC_KEY=REPLACE_WITH_THE_MAC_32_BYTE_BASE64_PUBLIC_KEY

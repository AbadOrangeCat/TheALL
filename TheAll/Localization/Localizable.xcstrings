    "ai.forget.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New terminals will ask for an API key again. Existing sessions keep their current connection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新终端将重新要求填写 API Key。已运行的会话继续使用当前连接。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouveaux terminaux demanderont à nouveau une clé API. Les sessions existantes conserveront leur connexion actuelle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいターミナルでは API キーの入力が再び必要になります。既存のセッションは現在の接続を維持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 터미널에서는 API 키를 다시 입력해야 합니다. 기존 세션은 현재 연결을 유지합니다."
          }
        }
      }
    },

    "mobile.lan.pairHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install and trust this Mac’s certificate on the phone first, then scan while both devices are on the same network."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在手机上安装并信任这台 Mac 的证书，再在同一网络下扫码。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez d’abord le certificat de ce Mac sur le téléphone et approuvez-le, puis scannez le code lorsque les deux appareils sont sur le même réseau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先にスマートフォンにこの Mac の証明書をインストールして信頼してください。その後、両方のデバイスを同じネットワークに接続して QR コードを読み取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 휴대폰에 이 Mac의 인증서를 설치하고 신뢰하도록 설정하세요. 그런 다음 두 기기가 같은 네트워크에 연결된 상태에서 스캔하세요."
          }
        }
      }
    },

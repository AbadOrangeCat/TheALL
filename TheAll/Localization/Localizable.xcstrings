          }
        }
      }
    },
    "mobile.lan.exportFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The certificate could not be exported. Choose a writable folder and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "证书导出失败，请选择可写入的文件夹重试。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’exporter le certificat. Choisissez un dossier accessible en écriture et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "証明書を書き出せませんでした。書き込み可能なフォルダを選択して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증서를 내보낼 수 없습니다. 쓰기 가능한 폴더를 선택한 후 다시 시도하세요."
          }
        }
      }
    },
    "mobile.lan.exportIOS": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export iPhone / iPad profile"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出 iPhone / iPad 安装文件"
          }
        },
        "fr": {

    "ai.error.key": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a non-empty API key without line breaks."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入有效的 API Key，不可包含换行符。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez une clé API non vide, sans saut de ligne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "改行を含まない API キーを入力してください。空欄にはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "줄바꿈이 없는 API 키를 입력하세요. 비워 둘 수 없습니다."
          }
        }
      }
    },
    "ai.error.url": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter an HTTPS Base URL without credentials, query parameters, or fragments. HTTP is supported for localhost."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入 HTTPS Base URL，不含用户名、密码、查询参数或片段。localhost 可使用 HTTP。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez une URL de base HTTPS sans identifiants, paramètres de requête ni fragment. HTTP est accepté pour localhost."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証情報、クエリパラメーター、フラグメントを含まない HTTPS のベース URL を入力してください。localhost では HTTP も使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증 정보, 쿼리 매개변수, 프래그먼트가 없는 HTTPS 기본 URL을 입력하세요. localhost에서는 HTTP도 지원됩니다."
          }
        }
      }
    },
    "ai.error.model": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model name cannot contain control characters."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型名称不可包含控制字符。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom du modèle ne peut pas contenir de caractères de contrôle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデル名に制御文字を含めることはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델 이름에는 제어 문자를 포함할 수 없습니다."
          }
        }
      }
    },
    "ai.error.corrupt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved connection could not be read. Replace it with a new connection, or delete it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取保存的连接。请填写新连接覆盖，或删除原连接。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire la connexion enregistrée. Remplacez-la par une nouvelle connexion ou supprimez-la."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みの接続を読み込めませんでした。新しい接続で置き換えるか、削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 연결을 읽을 수 없습니다. 새 연결로 바꾸거나 삭제하세요."
          }
        }
      }
    },
    "ai.error.keychainAuthorization": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved connection cannot be accessed without system authorization. Unlock your login Keychain and try again. If the app's signing identity changed, use the original signing identity or repair this item's access in Keychain Access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法静默访问保存的连接。请解锁登录钥匙串后重试；若更换了应用签名，请恢复原签名构建，或在“钥匙串访问”中修复该条目的访问权限。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion enregistrée nécessite une autorisation système. Déverrouillez votre trousseau de session et réessayez. Si l’identité de signature de l’application a changé, utilisez l’identité d’origine ou corrigez l’accès à cet élément dans Trousseaux d’accès."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みの接続にアクセスするには、システムの認証が必要です。ログインキーチェーンのロックを解除して、もう一度お試しください。アプリの署名 ID が変わった場合は、元の署名 ID を使用するか、キーチェーンアクセスでこの項目のアクセス権を修復してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 연결에 접근하려면 시스템 승인이 필요합니다. 로그인 키체인의 잠금을 해제한 후 다시 시도하세요. 앱의 서명 ID가 변경되었다면 원래 서명 ID를 사용하거나 키체인 접근에서 이 항목의 접근 권한을 복구하세요."
          }
        }
      }
    },
    "ai.error.keychainLegacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previous build’s saved connection cannot be migrated without system authorization. Enter your API key once to save it in the new secure store; future app updates will reuse it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧构建保存的连接无法在不进行系统授权的情况下迁移。请重新填写一次 API Key，保存到新的安全存储后，后续应用更新将继续复用。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion enregistrée par la version précédente nécessite une autorisation système pour être migrée. Saisissez votre clé API une fois pour l’enregistrer dans le nouveau stockage sécurisé ; les prochaines mises à jour la réutiliseront."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前のビルドで保存した接続を移行するには、システムの認証が必要です。API キーを一度入力すると、新しい安全な保存先に保存され、今後のアプリ更新でも再利用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 빌드에서 저장한 연결을 이전하려면 시스템 승인이 필요합니다. API 키를 한 번 입력하여 새 보안 저장소에 저장하세요. 이후 앱 업데이트에서도 다시 사용됩니다."
          }
        }
      }
    },
    "ai.error.keychain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keychain access failed (%d). Unlock your login Keychain and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问钥匙串（%d）。请解锁登录钥匙串后重试。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de l’accès au trousseau (%d). Déverrouillez votre trousseau de session et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーチェーンへのアクセスに失敗しました（%d）。ログインキーチェーンのロックを解除して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키체인 접근에 실패했습니다(%d). 로그인 키체인의 잠금을 해제한 후 다시 시도하세요."
          }
        }
      }
    },
    "ai.error.cli": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not find %@. Install the CLI in ~/.local/bin, /opt/homebrew/bin, /usr/local/bin, or your PATH, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到 %@。请将该命令行工具安装到 ~/.local/bin、/opt/homebrew/bin、/usr/local/bin 或 PATH 中，然后重试。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est introuvable. Installez le CLI dans ~/.local/bin, /opt/homebrew/bin, /usr/local/bin ou dans votre PATH, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が見つかりません。CLI を ~/.local/bin、/opt/homebrew/bin、/usr/local/bin、または PATH 内の場所にインストールして、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 찾을 수 없습니다. CLI를 ~/.local/bin, /opt/homebrew/bin, /usr/local/bin 또는 PATH에 포함된 위치에 설치한 후 다시 시도하세요."
          }
        }
      }
    },

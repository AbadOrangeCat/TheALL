    "ai.error.credentialHelper": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Secure credential storage could not start. Restore the original signed app and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安全凭据存储无法启动。请恢复原签名的应用后重试。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stockage sécurisé des identifiants n’a pas pu démarrer. Restaurez l’application signée d’origine et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証情報の安全な保存機能を起動できませんでした。元の署名付きアプリに戻して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보안 인증 정보 저장소를 시작할 수 없습니다. 원래 서명된 앱을 복원한 후 다시 시도하세요."
          }
        }
      }
    },
    "ai.history.chatChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This chat now has messages. Restore the older conversation in a new empty tab."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前聊天已有新消息，请在新的空白标签页中恢复旧对话。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette conversation contient désormais des messages. Restaurez l’ancienne conversation dans un nouvel onglet vide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチャットにはすでにメッセージがあります。以前の会話は、新しい空のタブに復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 대화에는 이미 메시지가 있습니다. 이전 대화는 비어 있는 새 탭에 복원하세요."
          }
        }
      }
    },
    "ai.history.connectionNeeded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your saved chat is available. Open Connection settings to reconnect and continue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天记录已恢复。请打开连接设置，重新连接后继续对话。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre conversation enregistrée est disponible. Ouvrez les réglages de connexion pour vous reconnecter et continuer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みのチャットを利用できます。接続設定を開いて再接続すると、会話を続けられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 대화를 사용할 수 있습니다. 연결 설정을 열어 다시 연결한 후 계속하세요."
          }
        }
      }
    },
    "ai.history.legacyDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the conversation to restore in this pane. Older versions did not save its workspace assignment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择要恢复到当前窗格的对话。旧版没有保存对话与工作区的对应关系。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la conversation à restaurer dans ce volet. Les anciennes versions n’enregistraient pas son espace de travail."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このペインに復元する会話を選択してください。以前のバージョンでは、会話が属するワークスペースは保存されていませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 패널에 복원할 대화를 선택하세요. 이전 버전에서는 대화가 속한 작업 공간을 저장하지 않았습니다."
          }
        }
      }
    },
    "ai.history.loadFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved chat history could not be read. The original file has been kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取聊天记录，原文件已保留。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire l’historique enregistré. Le fichier d’origine a été conservé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みのチャット履歴を読み込めませんでした。元のファイルは保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 대화 기록을 읽을 수 없습니다. 원본 파일은 보존되었습니다."
          }
        }
      }
    },
    "ai.history.missingSession": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The messages are saved, but the backend session ID is missing. This chat cannot resume automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天内容已保留，但缺少后端会话编号，无法自动继续此对话。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages sont enregistrés, mais l’identifiant de session du moteur IA est manquant. Cette conversation ne peut pas reprendre automatiquement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージは保存されていますが、バックエンドのセッション ID がありません。このチャットは自動では再開できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지는 저장되어 있지만 백엔드 세션 ID가 없습니다. 이 대화는 자동으로 이어갈 수 없습니다."
          }
        }
      }
    },
    "ai.history.none": {

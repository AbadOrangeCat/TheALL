        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect when away from your Mac using your own HTTPS relay. No phone VPN app is required."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外出时通过自行部署的 HTTPS 中继连接 Mac，手机无需安装 VPN。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à distance à votre Mac via votre propre relais HTTPS. Aucune application VPN n’est nécessaire sur le téléphone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独自の HTTPS 中継サーバーを使って、Mac から離れた場所でも接続できます。スマートフォンに VPN アプリは不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자체 HTTPS 중계 서버를 통해 Mac에서 멀리 떨어져 있어도 연결할 수 있습니다. 휴대폰용 VPN 앱은 필요하지 않습니다."
          }
        }

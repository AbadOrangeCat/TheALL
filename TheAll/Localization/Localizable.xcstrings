    "mobile.lan.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac address is no longer available. Connect to Wi-Fi or Ethernet, then select a current address."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 地址已不可用，请连接 Wi-Fi 或以太网，再选择当前地址。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette adresse du Mac n’est plus disponible. Connectez-vous au Wi-Fi ou à Ethernet, puis sélectionnez une adresse actuelle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac のアドレスは使用できなくなりました。Wi-Fi または Ethernet に接続して、現在のアドレスを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac 주소는 더 이상 사용할 수 없습니다. Wi-Fi 또는 이더넷에 연결한 후 현재 주소를 선택하세요."
          }
        }
      }
    },
    "mobile.localOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This preview address works only in a browser on this Mac. For your phone, use Local network or Internet relay pairing above."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此预览地址仅供当前 Mac 的浏览器使用。手机请使用上方的局域网配对或外网配对。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette adresse d’aperçu ne fonctionne que dans un navigateur sur ce Mac. Pour le téléphone, utilisez l’association au réseau local ou au relais Internet ci-dessus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプレビュー用アドレスは、この Mac 上のブラウザーでのみ利用できます。スマートフォンでは、上のローカルネットワークまたはインターネット中継のペアリングを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 미리보기 주소는 이 Mac의 브라우저에서만 작동합니다. 휴대폰에서는 위의 로컬 네트워크 또는 인터넷 중계 페어링을 사용하세요."
          }
        }
      }
    },
    "mobile.modesHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local network and internet relay can run together. Pair separately for each address."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "局域网直连和外网中继可以同时开启，不同地址需分别配对。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le réseau local et le relais Internet peuvent fonctionner simultanément. Associez le téléphone séparément pour chaque adresse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルネットワークとインターネット中継は同時に利用できます。アドレスごとに個別にペアリングしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 네트워크와 인터넷 중계를 동시에 사용할 수 있습니다. 각 주소에 대해 별도로 페어링하세요."
          }
        }
      }
    },

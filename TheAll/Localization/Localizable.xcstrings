{
  "sourceLanguage": "en",
  "strings": {
    "app.ghostty.notFound.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TheAll requires Ghostty to be installed.\nRun scripts/build-vendor.sh first, then relaunch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TheAll 需要安装 Ghostty。请先运行 scripts/build-vendor.sh，然后重新启动。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TheAll nécessite l’installation de Ghostty.\nExécutez d’abord scripts/build-vendor.sh, puis relancez l’application."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TheAll を使用するには Ghostty が必要です。\n先に scripts/build-vendor.sh を実行してから、アプリを再起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TheAll을 사용하려면 Ghostty를 설치해야 합니다.\n먼저 scripts/build-vendor.sh를 실행한 후 앱을 다시 실행하세요."
          }
        }
      }
    },
    "app.ghostty.notFound.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghostty not found"

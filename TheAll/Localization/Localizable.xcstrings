    "ai.stop.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause this chat to edit the connection?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停聊天并修改连接？"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre cette conversation en pause pour modifier la connexion ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチャットを一時停止して接続を編集しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결을 편집하기 위해 이 대화를 일시 중지할까요?"
          }
        }
      }
    },
    "ai.stop.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current work will stop. Messages and your draft are kept, and the chat resumes after reconnecting to the same provider."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前任务将停止。聊天记录和草稿会保留，重新连接同一 AI 后可继续对话。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le travail en cours sera arrêté. Les messages et votre brouillon seront conservés. La conversation reprendra après la reconnexion au même fournisseur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の処理が停止します。メッセージと下書きは保持され、同じプロバイダーに再接続するとチャットが再開されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진행 중인 작업이 중지됩니다. 메시지와 초안은 유지되며, 같은 제공업체에 다시 연결하면 대화가 이어집니다."
          }
        }
      }
    },
    "ai.stop.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",

    "mobile.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View shared workspaces from iOS or Android and continue conversations when allowed. Your Mac runs every task."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iOS 或 Android 上查看已共享的工作区，并在权限允许时继续对话。所有任务都在 Mac 上运行。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez les espaces de travail partagés sur iOS ou Android et poursuivez les conversations si vos autorisations le permettent. Toutes les tâches s’exécutent sur votre Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS または Android から共有されたワークスペースを確認し、権限がある場合は会話を続けられます。すべてのタスクは Mac で実行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 또는 Android에서 공유된 작업 공간을 확인하고, 권한이 있으면 대화를 이어가세요. 모든 작업은 Mac에서 실행됩니다."
          }
        }
      }
    },
    "mobile.devices": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paired devices · expires after 30 days"
          }
        },
        "zh-Hans": {
          "stringUnit": {

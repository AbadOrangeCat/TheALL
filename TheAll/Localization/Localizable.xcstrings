    "mobile.share.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These permissions apply to the next pairing code. View-only devices cannot send messages, answer questions, stop tasks or create conversations."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些权限适用于接下来生成的配对码。仅查看设备不能发消息、回答问题、停止任务或创建对话。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces autorisations s’appliqueront au prochain code d’association. Les appareils en consultation seule ne peuvent ni envoyer de messages, ni répondre aux questions, ni arrêter des tâches, ni créer de conversations."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この権限は、次に生成するペアリングコードに適用されます。閲覧のみのデバイスは、メッセージの送信、質問への回答、タスクの停止、会話の新規作成ができません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 권한은 다음 페어링 코드에 적용됩니다. 보기 전용 기기는 메시지를 보내거나, 질문에 답하거나, 작업을 중지하거나, 새 대화를 만들 수 없습니다."
          }
        }
      }
    },

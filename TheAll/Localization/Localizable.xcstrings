          }
        }
      }
    },
    "mobile.error.authorization": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair this device again from the Mac. Its access may have expired or been revoked."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请从电脑端重新配对此设备，访问权限可能已过期或被撤销。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Associez à nouveau cet appareil depuis le Mac. Son accès a peut-être expiré ou été révoqué."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac からこのデバイスを再度ペアリングしてください。アクセス権が期限切れか、取り消されている可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 이 기기를 다시 페어링하세요. 접근 권한이 만료되었거나 취소되었을 수 있습니다."
          }
        }
      }
    },
    "mobile.error.busy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The conversation is busy or waiting for an answer. Wait for it to finish or answer the question."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前对话正在运行或等待回答，请等待任务结束或先回答问题。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La conversation est en cours de traitement ou attend une réponse. Attendez la fin du traitement ou répondez à la question."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会話は処理中、または回答待ちです。処理の完了を待つか、質問に回答してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화가 처리 중이거나 답변을 기다리고 있습니다. 완료될 때까지 기다리거나 질문에 답하세요."
          }
        }
      }
    },
    "mobile.error.capacity": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The mobile request log is full. Restart TheAll after current work finishes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机请求记录已满，请在当前任务结束后重启 TheAll。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le journal des requêtes mobiles est plein. Redémarrez TheAll une fois le travail en cours terminé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モバイルリクエストの記録が上限に達しました。現在の処理が完了してから TheAll を再起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모바일 요청 기록이 가득 찼습니다. 현재 작업이 완료된 후 TheAll을 다시 시작하세요."
          }
        }
      }
    },
    "mobile.error.changed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This conversation changed while connecting. Refresh and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接期间此对话发生了变化，请刷新后再试。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette conversation a changé pendant la connexion. Actualisez et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続中にこの会話が変更されました。更新して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 중에 이 대화가 변경되었습니다. 새로고침한 후 다시 시도하세요."
          }
        }
      }
    },
    "mobile.error.connection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure and save this AI connection on the Mac first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在电脑端配置并保存此 AI 连接。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez et enregistrez d’abord cette connexion IA sur le Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に Mac でこの AI 接続を設定して保存してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 Mac에서 이 AI 연결을 설정하고 저장하세요."
          }
        }
      }
    },
    "mobile.error.directory": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The working folder does not exist on this Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此工作文件夹在电脑端不存在。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier de travail n’existe pas sur ce Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac に作業フォルダがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에 작업 폴더가 없습니다."
          }
        }
      }
    },
    "mobile.error.disabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mobile access is disabled on the Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑端已关闭手机连接。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès mobile est désactivé sur le Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac でモバイルアクセスが無効になっています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 모바일 접근이 꺼져 있습니다."
          }
        }
      }
    },
    "mobile.error.history": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The conversation could not be read. Its saved history was preserved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取对话，已保存的记录已保留。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire cette conversation. Son historique enregistré a été conservé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話を読み込めませんでした。保存済みの履歴は保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화를 읽을 수 없습니다. 저장된 기록은 보존되었습니다."
          }
        }
      }
    },
    "mobile.error.identity": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac relay identity could not be loaded. Its existing identity file has been preserved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取电脑的中继身份，已有身份文件已保留。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger l’identité du Mac pour le relais. Le fichier d’identité existant a été conservé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中継接続用の Mac の ID を読み込めませんでした。既存の ID ファイルは保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac의 중계 연결 ID를 불러올 수 없습니다. 기존 ID 파일은 보존되었습니다."
          }
        }
      }
    },
    "mobile.error.listen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not open the local connection port. Another TheAll instance may already be using it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法开启本机连接端口，可能已有另一个 TheAll 实例占用。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir le port de connexion local. Une autre instance de TheAll l’utilise peut-être déjà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカル接続用のポートを開けませんでした。別の TheAll がすでに使用している可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 연결 포트를 열 수 없습니다. 다른 TheAll 인스턴스에서 이미 사용 중일 수 있습니다."
          }
        }
      }
    },
    "mobile.error.notFound": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This workspace or conversation no longer exists."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此工作区或对话已不存在。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet espace de travail ou cette conversation n’existe plus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このワークスペースまたは会話は存在しなくなりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업 공간 또는 대화는 더 이상 존재하지 않습니다."
          }
        }
      }
    },
    "mobile.error.notReady": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI connection is not ready. Check its status on the Mac, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 连接尚未就绪，请检查电脑端状态后再试。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion IA n’est pas prête. Vérifiez son état sur le Mac, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 接続の準備ができていません。Mac で状態を確認してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 연결이 준비되지 않았습니다. Mac에서 상태를 확인한 후 다시 시도하세요."
          }
        }
      }
    },
    "mobile.error.origin": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This connection address is not authorized. Use the address configured on the Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此连接地址未经授权，请使用电脑端配置的地址。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette adresse de connexion n’est pas autorisée. Utilisez l’adresse configurée sur le Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この接続先アドレスは許可されていません。Mac で設定したアドレスを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 연결 주소는 허용되지 않습니다. Mac에 설정된 주소를 사용하세요."
          }
        }
      }
    },
    "mobile.error.pair": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This invitation has expired or was already used. Generate a new pairing link on the Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对邀请已过期或已使用，请在电脑上生成新链接。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette invitation a expiré ou a déjà été utilisée. Générez un nouveau lien d’association sur le Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この招待は期限切れ、または使用済みです。Mac で新しいペアリングリンクを生成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 초대는 만료되었거나 이미 사용되었습니다. Mac에서 새 페어링 링크를 생성하세요."
          }
        }
      }
    },
    "mobile.error.pending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This request is still being processed. Check the conversation before retrying the same request."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此请求仍在处理中，请检查对话后再重试同一请求。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette requête est encore en cours de traitement. Vérifiez la conversation avant de renvoyer la même requête."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリクエストはまだ処理中です。同じリクエストを再試行する前に、会話を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 요청은 아직 처리 중입니다. 같은 요청을 다시 시도하기 전에 대화를 확인하세요."
          }
        }
      }
    },
    "mobile.error.question": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This question was already answered or the answer is incomplete. Refresh the conversation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此问题已被回答或答案不完整，请刷新对话。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette question a déjà reçu une réponse ou la réponse est incomplète. Actualisez la conversation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この質問にはすでに回答済みか、回答が不完全です。会話を更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 답변한 질문이거나 답변이 완전하지 않습니다. 대화를 새로고침하세요."
          }
        }
      }
    },
    "mobile.error.rate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many pairing attempts. Try again in a minute."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对尝试过多，请稍后一分钟再试。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de tentatives d’association. Réessayez dans une minute."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングの試行回数が多すぎます。1 分後にもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링 시도 횟수가 너무 많습니다. 1분 후 다시 시도하세요."
          }
        }
      }
    },
    "mobile.error.relay": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay disconnected. TheAll will reconnect automatically. Check the address, server and configured Mac public identity."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中继已断开，TheAll 会自动重连。请检查地址、服务器和配置的电脑公钥。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le relais est déconnecté. TheAll se reconnectera automatiquement. Vérifiez l’adresse, le serveur et l’identité publique du Mac configurée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中継接続が切断されました。TheAll は自動的に再接続します。アドレス、サーバー、設定済みの Mac の公開 ID を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중계 연결이 끊겼습니다. TheAll이 자동으로 다시 연결합니다. 주소, 서버, 설정된 Mac 공개 ID를 확인하세요."
          }
        }
      }
    },
    "mobile.error.request": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request is invalid."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求格式无效。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La requête n’est pas valide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストが無効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유효하지 않은 요청입니다."
          }
        }
      }
    },
    "mobile.error.requestReuse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This request ID was already used for a different action."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此请求编号已用于其他操作。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet identifiant de requête a déjà été utilisé pour une autre action."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリクエスト ID は、すでに別の操作に使用されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 요청 ID는 이미 다른 작업에 사용되었습니다."
          }
        }
      }
    },
    "mobile.error.restarted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac service restarted. Check the conversation before submitting a new request; the previous action will not be retried automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑端服务已重启。请先检查对话再发起新请求，旧操作不会自动重试。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service du Mac a redémarré. Vérifiez la conversation avant d’envoyer une nouvelle requête ; l’action précédente ne sera pas relancée automatiquement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac のサービスが再起動しました。新しいリクエストを送信する前に会話を確認してください。前の操作は自動では再試行されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 서비스가 다시 시작되었습니다. 새 요청을 보내기 전에 대화를 확인하세요. 이전 작업은 자동으로 다시 시도되지 않습니다."
          }
        }
      }
    },
    "mobile.error.storage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save paired devices. Existing device data was preserved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存配对设备，已有设备数据已保留。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer les appareils associés. Les données existantes ont été conservées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリング済みのデバイスを保存できませんでした。既存のデバイス情報は保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링된 기기를 저장할 수 없습니다. 기존 기기 데이터는 보존되었습니다."
          }
        }
      }
    },
    "mobile.error.url": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use an HTTPS address without a path, username, query or fragment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用 HTTPS 地址，不要附带路径、用户名、查询参数或片段。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez une adresse HTTPS sans chemin, nom d’utilisateur, requête ni fragment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パス、ユーザー名、クエリ、フラグメントを含まない HTTPS アドレスを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경로, 사용자 이름, 쿼리, 프래그먼트가 없는 HTTPS 주소를 사용하세요."
          }
        }
      }
    },
    "mobile.guide": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale connection guide"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale 连接说明"

    "app.migration.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your existing settings and conversations have been preserved. Resolve the problem below, then reopen TheAll."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原有设置和对话已保留。解决以下问题后，请重新打开 TheAll。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos réglages et conversations existants ont été conservés. Résolvez le problème ci-dessous, puis rouvrez TheAll."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存の設定と会話は保持されています。以下の問題を解決してから、TheAll をもう一度開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 설정과 대화는 보존되었습니다. 아래 문제를 해결한 후 TheAll을 다시 여세요."
          }

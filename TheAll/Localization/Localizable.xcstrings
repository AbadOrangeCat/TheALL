    "settings.agents.notificationsFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show running / idle / finished status icons next to tabs that run the selected agents."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在跑这些 agent 的 tab 旁显示运行 / 闲置 / 完成的状态图标。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher des icônes d’état (en cours, inactif ou terminé) à côté des onglets qui exécutent les agents sélectionnés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したエージェントを実行しているタブの横に、実行中・待機中・完了の状態アイコンを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 에이전트를 실행하는 탭 옆에 실행 중, 대기 중, 완료 상태 아이콘을 표시합니다."
          }
        }
      }
    },
    "settings.agents.resumeTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume on Launch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动时恢复会话"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprendre au lancement"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動時に再開"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 시 이어서 시작"
          }
        }
      }
    },
    "settings.agents.resumeFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On next launch, auto-run `claude --resume <id>` / `codex resume <id>` to land back in the most recent session. Off by default. Turning a row off also drops any saved session id."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下次启动时自动执行 `claude --resume <id>` / `codex resume <id>`，回到最近一次的会话。默认关闭。关闭某一行同时会清除已保存的会话 id。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au prochain lancement, exécuter automatiquement `claude --resume <id>` / `codex resume <id>` pour reprendre la dernière session. Désactivé par défaut. Désactiver une ligne efface également l’identifiant de session enregistré."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次回の起動時に `claude --resume <id>` / `codex resume <id>` を自動実行し、直近のセッションを再開します。デフォルトではオフです。項目をオフにすると、保存済みのセッション ID も削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 실행 시 `claude --resume <id>` / `codex resume <id>`를 자동으로 실행하여 가장 최근 세션을 이어갑니다. 기본적으로 꺼져 있습니다. 항목을 끄면 저장된 세션 ID도 삭제됩니다."
          }
        }
      }
    },
